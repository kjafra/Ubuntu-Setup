#!/usr/bin/env bash
# Git credential helper for Azure DevOps. Answers `get` requests for
# dev.azure.com with the PAT stored in the `azure-devops-pat` Podman
# secret. `store`/`erase` are no-ops, so nothing is ever written to disk.
# Installed to ~/.local/bin by install-azure-devops-git-credentials.sh.
[[ "${1:-}" == "get" ]] || exit 0

host=""
while IFS='=' read -r key value; do
    [[ -n "$key" ]] || break
    [[ "$key" == "host" ]] && host="$value"
done
[[ "$host" == "dev.azure.com" || "$host" == *.visualstudio.com ]] || exit 0

for brew in /home/linuxbrew/.linuxbrew/bin "$HOME/.linuxbrew/bin"; do
    [[ -d "$brew" ]] && PATH="$brew:$PATH"
done
command -v podman >/dev/null 2>&1 || exit 0

pat="$(timeout 5 podman secret inspect --showsecret --format '{{.SecretData}}' azure-devops-pat 2>/dev/null)" || exit 0
[[ -n "$pat" ]] || exit 0

printf 'username=pat\npassword=%s\n' "$pat"
